                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="ScrollBar">
                                                <Style.Triggers>
                                                    <Trigger Property="Orientation" Value="Horizontal">
                                                        <Setter Property="Height" Value="26"/>
                                                        <Setter Property="AutomationProperties.Name" Value="历史表横向滚动条"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ScrollBar">
                                                                    <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Line}"
                                                                            BorderThickness="0,1,0,0" Padding="6,0">
                                                                        <Track x:Name="PART_Track" Orientation="Horizontal">
                                                                            <Track.DecreaseRepeatButton>
                                                                                <RepeatButton Style="{StaticResource HistoryScrollTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                                                                            </Track.DecreaseRepeatButton>
                                                                            <Track.IncreaseRepeatButton>
                                                                                <RepeatButton Style="{StaticResource HistoryScrollTrackButton}" Command="ScrollBar.PageRightCommand"/>
                                                                            </Track.IncreaseRepeatButton>
