                        <Button Content="复制联系电话" Click="CopyPhone_Click" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AccessPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="权限管理" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Panel}" Width="450" Padding="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding OperatorLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Label Content="用户名" Target="{Binding ElementName=LoginUserName}" Foreground="{StaticResource Text}" Padding="0,0,0,5"/>
                                <TextBox x:Name="LoginUserName" Text="{x:Static local:StationView.AdministratorName}" IsReadOnly="True"
                                         IsTabStop="False" AutomationProperties.Name="用户名"/>
                                <Label Content="密码" Target="{Binding ElementName=LoginPassword}" Foreground="{StaticResource Text}"
                                       Padding="0,0,0,5" Margin="0,12,0,0"/>
                                <PasswordBox x:Name="LoginPassword" MaxLength="128" IsEnabled="{Binding NotBusy}"
                                             AutomationProperties.Name="密码" KeyDown="LoginField_KeyDown"/>
                                <TextBlock x:Name="LoginError" Foreground="{StaticResource Red}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,9,0,0"/>
                                <Button Content="登录" Click="Login_Click" IsEnabled="{Binding NotBusy}"
                                        Style="{StaticResource Primary}" Margin="0,13,0,0"/>
                            </StackPanel>
                            <Button Content="退出登录" Click="Logout_Click" IsEnabled="{Binding CanLogout}"
                                    Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
            <local:DeviceManagement x:Name="DevicesPage" Visibility="Collapsed"/>

            <Grid x:Name="SystemPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="系统设置" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Panel}" Width="520" Padding="23" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="运行时间统计" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                            <Label Content="运行状态线圈地址" Target="{Binding ElementName=RuntimeAddress}"
                                   Foreground="{StaticResource Text}" FontWeight="SemiBold" Padding="0,0,0,5"/>
                            <TextBox x:Name="RuntimeAddress" MaxLength="6" IsEnabled="{Binding CanEditSystemSettings}"
                                     AutomationProperties.Name="运行状态线圈地址"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="可输入 M10、Y10 或从 0 开始的十进制线圈地址。连接 PLC 后，线圈为 1 时累加运行时间，结果显示在状态监控页。留空则不统计。"/>
                            <TextBlock x:Name="RuntimeSettingsError" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="累计时间清零" Click="ResetRuntime_Click" IsEnabled="{Binding CanEditSystemSettings}" Margin="0,0,8,0"/>
                                <Button Content="保存设置" Click="SaveRuntimeSettings_Click" IsEnabled="{Binding CanEditSystemSettings}"
                                        Style="{StaticResource Primary}"/>
                            </StackPanel>
                            <TextBlock Text="请登录管理员账号修改系统设置。" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Notice}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"
                   Foreground="{StaticResource Muted}" Margin="25,0"/>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
            <UniformGrid x:Name="Navigation" Columns="8">
                <Button Click="Navigate_Click" CommandParameter="0" Content="状态监控" Style="{StaticResource NavButton}" Tag="active"/>
                <Button Click="Navigate_Click" CommandParameter="1" Content="手动窗口" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="2" Content="参数设置" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="3" Content="历史数据" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="6" Content="设备管理" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="7" Content="系统设置" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="4" Content="联系我们" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="5" Content="权限管理" Style="{StaticResource NavButton}"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
