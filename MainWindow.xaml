                                                                                                <Border x:Name="Grip" Background="{StaticResource Muted}" CornerRadius="6" Margin="0,5"/>
                                                                                            </Grid>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsDragging" Value="True">
                                                                                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentHover}"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsEnabled" Value="False">
