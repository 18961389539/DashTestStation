                                        <TextBlock Text="总判定" Style="{StaticResource MutedText}" Margin="0,4,8,4"/>
                                        <ComboBox x:Name="ResultFilter" Width="96" SelectedIndex="0" SelectedValuePath="Tag" Margin="0,4,12,4"
