                                        <Button Content="导出 CSV" Click="Export_Click" IsEnabled="{Binding NotBusy}" Margin="0,0,7,0"/>
                                        <Button Content="删除选中" Click="DeleteHistory_Click" IsEnabled="{Binding CanDelete}"/>
                                    </StackPanel>
