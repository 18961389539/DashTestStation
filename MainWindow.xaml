                                    <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="累计运行时间" Style="{StaticResource MutedText}" FontSize="12"/>
                                            <TextBlock Text="{Binding RuntimeLabel}" FontFamily="Consolas" FontSize="30"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource SystemHint}"/>
                                        </StackPanel>
                                    </Border>
                                    <Label Content="运行状态线圈地址" Target="{Binding ElementName=RuntimeAddress}"
                                           Style="{StaticResource SystemFieldLabel}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="RuntimeAddress" MaxLength="6" Style="{StaticResource SystemField}"
                                             AutomationProperties.Name="运行状态线圈地址"/>
                                    <TextBlock Text="例如 M10、Y10、X0、S0、HM0 或零基十进制地址。留空则停用统计，已累计的时间会保留。"
                                               Style="{StaticResource SystemHint}"/>
                                    <TextBlock x:Name="RuntimeSettingsError" Text="" Style="{StaticResource SystemError}"/>
                                    <Border Background="{StaticResource Input}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="计时规则" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="线圈为 1 时累加，为 0 时暂停。通讯中断和模拟模式不计时。"
                                                       Style="{StaticResource SystemHint}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ScannerSettingsCard" Grid.Column="2" Style="{StaticResource Panel}" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="扫码触发与写回" Style="{StaticResource Section}"/>
                                        <TextBlock Text="触发扫码 → 按配方比对 → 写回 PLC → 清零触发" Style="{StaticResource SystemHint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="168"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,14,10">
                                            <Label Content="扫码触发线圈" Target="{Binding ElementName=ScannerTriggerAddress}"
                                                   Style="{StaticResource SystemFieldLabel}"/>
                                            <TextBlock Text="默认 Y11，留空停用触发" Style="{StaticResource SystemHint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <DockPanel Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource EditIcon}" Click="EditScannerTrigger_Click"
                                                    IsEnabled="{Binding CanEditSystemSettings}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    AutomationProperties.Name="编辑扫码触发线圈"/>
                                            <TextBox x:Name="ScannerTriggerAddress" MaxLength="12" IsReadOnly="True"
                                                     Style="{StaticResource SystemField}" AutomationProperties.Name="扫码触发线圈地址"/>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,14,10">
                                            <Label Content="二维码写回地址" Target="{Binding ElementName=ScannerBarcodeAddress}"
                                                   Style="{StaticResource SystemFieldLabel}"/>
                                            <TextBlock Text="默认 D4000，连续 80 字 / 160 字节" Style="{StaticResource SystemHint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource EditIcon}" Click="EditScannerBarcode_Click"
                                                    IsEnabled="{Binding CanEditSystemSettings}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    AutomationProperties.Name="编辑二维码写回地址"/>
                                            <TextBox x:Name="ScannerBarcodeAddress" MaxLength="8" IsReadOnly="True"
                                                     Style="{StaticResource SystemField}" AutomationProperties.Name="二维码存储寄存器地址"/>
                                        </DockPanel>
                                        <StackPanel Grid.Row="2" Margin="0,0,14,0">
                                            <Label Content="比对结果写回地址" Target="{Binding ElementName=ScannerVerdictAddress}"
                                                   Style="{StaticResource SystemFieldLabel}"/>
                                            <TextBlock Text="默认 D3，单个保持寄存器" Style="{StaticResource SystemHint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <DockPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource EditIcon}" Click="EditScannerVerdict_Click"
                                                    IsEnabled="{Binding CanEditSystemSettings}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    AutomationProperties.Name="编辑比对结果写回地址"/>
                                            <TextBox x:Name="ScannerVerdictAddress" MaxLength="8" IsReadOnly="True"
                                                     Style="{StaticResource SystemField}" AutomationProperties.Name="扫码比对结果寄存器地址"/>
                                        </DockPanel>
                                    </Grid>
                                    <Border Background="{StaticResource Input}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="1 · 匹配" Foreground="{StaticResource Green}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                                <TextBlock Text="2 · 不匹配" Foreground="{StaticResource Red}" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                            <TextBlock Text="两条都写入成功后才清零触发。写回失败会重试同一条码，不会重新扫码。"
                                                       Style="{StaticResource SystemHint}"/>
                                        </StackPanel>
                                    </Border>
                                    <Expander x:Name="ScannerSettingsHelp" Header="二维码比对与编码" IsExpanded="False"
                                              Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0">
                                        <StackPanel Margin="2,8,2,0">
                                            <TextBlock Text="{Binding ActiveRecipeLabel, StringFormat=当前启用配方：{0}}"
                                                       Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ActiveRecipe.Model, StringFormat=产品型号：{0}}"
                                                       Style="{StaticResource SystemHint}"/>
                                            <TextBlock Text="从开始序号（从 1 开始）截取对比长度，与完整产品型号区分大小写比较。对比长度为 0 时使用产品型号的长度。"
                                                       Style="{StaticResource SystemHint}"/>
                                            <TextBlock Text="二维码按 UTF-8 写入，每字高字节在前；写入前先清空 80 个寄存器，再按实际长度动态写入，最多 160 字节，超长报错不截断。扫码超时或通讯失败会提示并重试。"
                                                       Style="{StaticResource SystemHint}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Notice}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"
                   Foreground="{StaticResource Muted}" Margin="25,0"/>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
            <UniformGrid x:Name="Navigation" Columns="8">
                <Button Click="Navigate_Click" CommandParameter="0" Content="状态监控" Style="{StaticResource NavButton}" Tag="active"/>
                <Button Click="Navigate_Click" CommandParameter="1" Content="手动窗口" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="2" Content="参数设置" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="3" Content="历史数据" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="6" Content="设备管理" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="7" Content="系统设置" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="4" Content="联系我们" Style="{StaticResource NavButton}"/>
                <Button Click="Navigate_Click" CommandParameter="5" Content="权限管理" Style="{StaticResource NavButton}"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
