                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Frame" Property="Opacity" Value=".45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
