<Window x:Class="DustLoadScada.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DustLoadScada"
        Title="灰尘负载测试台" Width="1200" Height="780" MinWidth="920" MinHeight="650"
        Icon="app.ico"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" Language="zh-CN">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
        <local:HistoryDeleteVisibilityConverter x:Key="DeleteWhenSelected"/>
        <Style x:Key="EditIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4,3,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{StaticResource Input}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Content" Value="&#xE70F;"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="IsEnabled" Value="{Binding CanEditMonitorPoints}"/>
            <Setter Property="Visibility" Value="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="仅管理员可编辑地址，请先登录。"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PointEdit" TargetType="Button" BasedOn="{StaticResource EditIcon}">
            <EventSetter Event="Click" Handler="EditMonitorPoint_Click"/>
        </Style>
        <Style x:Key="ManualCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Text}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="51"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Feedback}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Green}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResetCommand" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="ToolTip" Value="点动复位：按下写入 1，松开写入 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <ContentPresenter x:Name="IdleLabel" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <StackPanel x:Name="HeldLabel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Ellipse x:Name="HeldDot" Width="9" Height="9" Fill="{StaticResource GreenDeep}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="已按下 · 复位中" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="held">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Green}"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GreenDeep}"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Frame" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Frame" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7DDEB7" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="IdleLabel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HeldLabel" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="HeldPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HeldDot" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.25" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="HeldPulse"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value=".40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="InspectionSwitchCard">
            <DockPanel Margin="0,0,0,7">
                <Button DockPanel.Dock="Right" Style="{StaticResource EditIcon}" VerticalAlignment="Center" Margin="6,0,0,0"
                        IsEnabled="{Binding DataContext.CanEditMonitorPoints, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=编辑{0}地址}"
                        Click="EditInspectionPoint_Click"/>
                <ToggleButton Click="InspectionSwitch_Click" IsChecked="{Binding Feedback, Mode=OneWay}" IsEnabled="{Binding Available}"
                              AutomationProperties.Name="{Binding Label}" MinHeight="42">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SwitchRow" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                                        <Border x:Name="Track" Width="40" Height="22" VerticalAlignment="Center"
                                                Background="{StaticResource Input}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="11" Padding="3,2">
                                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left"
                                                     Fill="{StaticResource Muted}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Green}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Green}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Input}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="Thumb" Property="Opacity" Value=".55"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwitchRow" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="SwitchRow" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ManualActionCard">
            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             ToolTip="{Binding State}" AutomationProperties.Name="{Binding State}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feedback}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Green}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Feedback}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource Line}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding State}" FontSize="11" Margin="5,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feedback}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Green}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ManualCommand}"
                        Content="{Binding Label}" ToolTip="{Binding Addresses}"
                        ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding State}"
                        CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Label}"
                        IsEnabled="{Binding Available}"
                        PreviewMouseLeftButtonDown="Manual_MouseDown" PreviewMouseLeftButtonUp="Manual_MouseUp"
                        PreviewMouseMove="Manual_MouseMove" Click="ManualAction_Click"
                        LostMouseCapture="Manual_LostMouseCapture" PreviewKeyDown="Manual_KeyDown"
                        PreviewKeyUp="Manual_KeyUp" LostKeyboardFocus="Manual_LostKeyboardFocus"
                        Stylus.IsPressAndHoldEnabled="False"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource EditIcon}" VerticalAlignment="Center" Margin="7,0,0,0"
                        IsEnabled="{Binding DataContext.CanEditMonitorPoints, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=编辑{0}地址}"
                        Click="EditManualPoint_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result}" TextWrapping="Wrap"
                           Margin="0,4,0,0" FontSize="13" ToolTip="{Binding Result}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultState}" Value="pending">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultState}" Value="error">
                                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="{StaticResource Input}" CornerRadius="6" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionColor}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ConnectionLabel}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" Height="28" CornerRadius="2" Background="{StaticResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock Text="灰尘负载测试台" Style="{StaticResource Title}"/>
                    <TextBlock Text="{Binding OperatorLabel}" Style="{StaticResource MutedText}" Margin="20,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,17,24,0">
            <ScrollViewer x:Name="MonitorPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Selected}" CornerRadius="8" Padding="15,11" BorderThickness="1"
                            BorderBrush="{StaticResource Accent}" Margin="0,0,0,13">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource EditIcon}" Click="EditTimerTrigger_Click"
                                    VerticalAlignment="Center" Margin="6,0,0,0" AutomationProperties.Name="编辑计时触发地址"/>
                            <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                       Text="{Binding Snapshot.Elapsed, StringFormat={}{0:0.0} s}" Margin="12,0,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StageLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.RunState}"
                                        VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="编辑运行状态地址"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,13">
                        <Border Style="{StaticResource Panel}" Padding="15,11" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="扫码信息" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding BarcodeLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BarcodeLabel}"
                                           FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="15,11" Margin="4,0">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Red}" BorderThickness="1" CornerRadius="4"
                                            Padding="5,0" VerticalAlignment="Center" ToolTip="扫码解析的型号与当前配方不一致"
                                            Visibility="{Binding ModelMismatch, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="不匹配" Foreground="{StaticResource Red}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="产品型号" Style="{StaticResource MutedText}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ModelLabel}" Foreground="{Binding ModelColor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelLabel}"
                                           FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="15,11" Margin="4,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="实时电压" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Snapshot.Voltage, StringFormat={}{0:0.00} V, TargetNullValue=—}"
                                               FontFamily="Consolas" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.Voltage}"
                                        AutomationProperties.Name="编辑实时电压"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="15,11" Margin="8,0,0,0">
                            <StackPanel ToolTip="{Binding RuntimeStatus}">
                                <TextBlock Text="累计运行时间" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding RuntimeLabel}" FontFamily="Consolas" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource MutedText}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="15,11" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="扫码比对" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding ScannerComparisonLabel}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ScannerComparisonLabel}" FontSize="18"
                                           FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="测试读数" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0"
                                                Visibility="{Binding ShowIndicatorOffCameraVerdict, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="跑马灯灭相机判定" Style="{StaticResource MutedText}" Margin="0,0,12,0"/>
                                        <Grid MinWidth="82" Height="49">
                                            <TextBlock Margin="0,17,0,0" HorizontalAlignment="Center"
                                                       Text="{Binding Snapshot.IndicatorOffCameraVerdict, Converter={StaticResource Verdict}}"
                                                       Foreground="{Binding Snapshot.IndicatorOffCameraVerdict, Converter={StaticResource Verdict}}"/>
                                            <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.IndicatorOffCameraVerdict}"
                                                    AutomationProperties.Name="编辑跑马灯灭相机判定"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowHeadlightIndicatorCameraVerdict, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="头灯跑马灯相机判定" Style="{StaticResource MutedText}" Margin="0,0,12,0"/>
                                        <Grid MinWidth="82" Height="49">
                                            <TextBlock Margin="0,17,0,0" HorizontalAlignment="Center"
                                                       Text="{Binding Snapshot.HeadlightIndicatorCameraVerdict, Converter={StaticResource Verdict}}"
                                                       Foreground="{Binding Snapshot.HeadlightIndicatorCameraVerdict, Converter={StaticResource Verdict}}"/>
                                            <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.HeadlightIndicatorCameraVerdict}"
                                                    AutomationProperties.Name="编辑头灯跑马灯相机判定"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.55*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="56"/>
                                        <RowDefinition Height="56"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Grid.ColumnSpan="5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"/>
                                    <Border Grid.Row="2" Grid.ColumnSpan="5" BorderThickness="0,1,0,1" BorderBrush="{StaticResource Line}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="测试项目" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="正常" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="灰尘" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="差值" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="判定" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="测试功率 (W)"/>
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.NormalPower, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.NormalPower}"
                                                AutomationProperties.Name="编辑正常功率"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.DustPower, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.DustPower}"
                                                AutomationProperties.Name="编辑灰尘功率"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="3">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.PowerDelta, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.PowerDelta}"
                                                AutomationProperties.Name="编辑功率差值"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="4">
                                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Snapshot.PowerVerdict, Converter={StaticResource Verdict}}"
                                                   Foreground="{Binding Snapshot.PowerVerdict, Converter={StaticResource Verdict}}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.PowerVerdict}"
                                                AutomationProperties.Name="编辑功率判定"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="测试转速 (r/min)"/>
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.NormalSpeed, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.NormalSpeed}"
                                                AutomationProperties.Name="编辑正常转速"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="2">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.DustSpeed, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.DustSpeed}"
                                                AutomationProperties.Name="编辑灰尘转速"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="3">
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource Reading}"
                                                   Text="{Binding Snapshot.SpeedDelta, StringFormat={}0.00, TargetNullValue=—}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.SpeedDelta}"
                                                AutomationProperties.Name="编辑转速差值"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="4">
                                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Snapshot.SpeedVerdict, Converter={StaticResource Verdict}}"
                                                   Foreground="{Binding Snapshot.SpeedVerdict, Converter={StaticResource Verdict}}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.SpeedVerdict}"
                                                AutomationProperties.Name="编辑转速判定"/>
                                    </Grid>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,1">
                                    <TextBlock Text="转速方向判定" Style="{StaticResource MutedText}" Margin="0,0,12,0"/>
                                    <Grid MinWidth="82" Height="49">
                                        <TextBlock Margin="0,17,0,0" HorizontalAlignment="Center"
                                                   Text="{Binding Snapshot.DirectionVerdict, Converter={StaticResource Verdict}}"
                                                   Foreground="{Binding Snapshot.DirectionVerdict, Converter={StaticResource Verdict}}"/>
                                        <Button Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.DirectionVerdict}"
                                                AutomationProperties.Name="编辑转速方向判定"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="总判定" Style="{StaticResource Section}"/>
                                <Button Grid.RowSpan="2" Style="{StaticResource PointEdit}" CommandParameter="{x:Static local:MonitorPointId.Result}"
