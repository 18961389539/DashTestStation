                                        <TextBlock Text="条码" Style="{StaticResource MutedText}" Margin="0,4,8,4"/>
                                        <TextBox x:Name="BarcodeFilter" KeyDown="BarcodeFilter_KeyDown" Width="160" Margin="0,4,12,4"
