                                    <Setter Property="CalendarButtonStyle" Value="{StaticResource HistoryCalendarMonth}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Calendar">
                                                <StackPanel x:Name="PART_Root">
                                                    <CalendarItem x:Name="PART_CalendarItem" Style="{StaticResource HistoryCalendarItem}"
                                                                  Background="{StaticResource Surface}" BorderThickness="0"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
