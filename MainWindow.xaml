            </Grid>

            <Grid x:Name="HistoryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="历史数据" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                <TabControl x:Name="HistoryTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
